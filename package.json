{
  "name": "joi-html-input",
  "version": "3.0.0",
  "description": "Joi validations for inputs that accept html",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@10.9.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekatron/joi-html-input.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "joi",
    "html",
    "sanitize",
    "validation",
    "xss"
  ],
  "author": "Dekatron",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/dekatron/joi-html-input/issues"
  },
  "homepage": "https://github.com/dekatron/joi-html-input#readme",
  "peerDependencies": {
    "joi": "^17.13.4 || ^18.0.0"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "html-entities": "^2.6.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "joi": "^18.2.3",
    "joi-v17": "npm:joi@^17.13.4",
    "publint": "^0.3.23",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
